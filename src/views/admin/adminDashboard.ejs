<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RegalAdmin</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --obsidian: #050505;
            --royal-gray: #0f0f0f;
            --royal-dark-gold: #1a160d; /* New background for row focus */
            --gold: #d4af37;
            --gold-glow: rgba(212, 175, 55, 0.4);
            --gold-muted: #b89c5e;
            --antique-brass: #8a6d3b;
            --text-main: #b8a178;
            --text-bright: #f1e5ac;
        }

        body {
            background-color: var(--obsidian);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            margin: 0;
            padding-top: 80px;
            overflow-x: hidden;
        }

        /* Royal Typography */
        h1, h2, h3, .royal-font {
            font-family: 'Cinzel', serif;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .gold-text {
            color: var(--gold);
            text-shadow: 0 0 10px var(--gold-glow);
        }

        /* Top Navigation Bar */
        .royal-navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 80px;
            background: var(--royal-gray);
            border-bottom: 2px solid var(--antique-brass);
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2rem;
            box-shadow: 0 5px 20px rgba(0,0,0,0.7);
        }

        .admin-profile {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .admin-avatar {
            width: 45px;
            height: 45px;
            border: 1px solid var(--gold);
            padding: 2px;
            background: var(--obsidian);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .admin-info {
            line-height: 1.2;
        }

        .admin-name {
            font-family: 'Cinzel', serif;
            font-size: 0.9rem;
            color: var(--gold);
            font-weight: bold;
            display: block;
        }

        .admin-email {
            font-size: 0.75rem;
            color: var(--antique-brass);
            display: block;
        }

        .admin-role-tag {
            font-family: 'Cinzel', serif;
            font-size: 0.65rem;
            color: var(--gold-muted);
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-top: 2px;
            display: block;
        }

        /* Layout Elements */
        .dashboard-container {
            padding: 3rem 1rem;
            max-width: 1100px;
            margin: auto;
        }

        .header-section {
            text-align: center;
            margin-bottom: 4rem;
            border-bottom: 1px solid var(--antique-brass);
            padding-bottom: 2rem;
        }

        /* The Card Design */
        .regal-card {
            background: var(--royal-gray);
            border: 1px solid var(--antique-brass);
            box-shadow: 0 20px 50px rgba(0,0,0,0.9);
            position: relative;
            padding: 2rem;
        }

        .regal-card::after {
            content: '';
            position: absolute;
            top: 5px; left: 5px; right: 5px; bottom: 5px;
            border: 1px solid rgba(212, 175, 55, 0.05);
            pointer-events: none;
        }

        /* Pure Dark Royal Table Styling */
        .table-responsive {
            background: var(--obsidian); /* Ensure the container is dark */
            border: 1px solid rgba(212, 175, 55, 0.1);
        }

        /* Search Section */
        .search-container {
            margin-bottom: 2.5rem;
            display: flex;
            justify-content: center;
            gap: 0.75rem;
            padding: 0 1rem;
        }

        .search-wrapper {
            position: relative;
            flex-grow: 1;
            max-width: 600px;
        }

        .search-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gold);
            pointer-events: none;
        }

        .search-input {
            width: 100%;
            background-color: #0a0a0a;
            border: 2px solid var(--gold);
            color: var(--text-bright);
            padding: 0.85rem 1rem 0.85rem 3rem;
            font-family: 'Cinzel', serif;
            font-size: 0.875rem;
            transition: all 0.3s;
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.1);
        }

        .search-input:focus {
            outline: none;
            box-shadow: 0 0 20px rgba(212, 175, 55, 0.2);
            border-color: var(--gold);
        }

        .search-input::placeholder {
            color: rgba(138, 109, 59, 0.5);
        }

        .btn-seek {
            background: transparent;
            border: 2px solid var(--gold);
            color: var(--gold) !important; /* Ensure text stays gold */
            font-family: 'Cinzel', serif;
            font-size: 0.875rem;
            font-weight: bold;
            padding: 0 2rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: all 0.3s;
            cursor: pointer;
        }

        .btn-seek:hover {
            background: rgba(212, 175, 55, 0.1);
            box-shadow: 0 0 25px rgba(212, 175, 55, 0.5);
            color: var(--gold) !important; /* Maintain gold color on hover */
        }

        .btn-seek:active {
            transform: scale(0.95);
        }
        .all{
            display: flex;
            justify-content: flex-end;
            margin-bottom: 20px;
        }

        .table {
            color: var(--text-main);
            border-color: rgba(212, 175, 55, 0.15);
            margin-bottom: 0;
            background-color: var(--obsidian) !important; /* Force dark background */
        }

        .table thead th {
            font-family: 'Cinzel', serif;
            color: var(--gold);
            border-bottom: 2px solid var(--gold) !important;
            font-size: 0.9rem;
            letter-spacing: 1.5px;
            background: #000 !important; /* Pure black headers */
            padding: 1.2rem 1rem;
        }

        .table tbody tr {
            background-color: transparent !important; /* Prevent bootstrap white rows */
            transition: all 0.3s ease;
            border-bottom: 1px solid rgba(212, 175, 55, 0.08);
        }

        .table td {
            padding: 1.2rem 1rem;
            background-color: transparent !important;
            border-color: rgba(212, 175, 55, 0.08) !important;
        }

        .table tbody tr:hover {
            background-color: var(--royal-dark-gold) !important;
            color: var(--text-bright);
        }

        .identity-text {
            color: var(--text-bright);
            font-weight: 600;
        }

        .courier-text {
            color: var(--gold-muted);
            font-size: 0.85rem;
        }

        /* Buttons */
        .btn-royal {
            background: transparent;
            border: 1px solid var(--gold);
            color: var(--gold);
            border-radius: 0;
            font-family: 'Cinzel', serif;
            font-size: 0.75rem;
            padding: 0.5rem 1.2rem;
            transition: 0.3s all;
            letter-spacing: 1px;
        }

        .btn-royal:hover {
            background: var(--gold);
            color: var(--obsidian);
            box-shadow: 0 0 20px var(--gold-glow);
        }

        .btn-banish {
            border-color: #5c141a;
            color: #d9534f;
        }

        .btn-banish:hover {
            background: #5c141a;
            color: #fff;
            box-shadow: 0 0 10px rgba(92, 20, 26, 0.6);
        }

        /* Centered Modal/Form */
        #modalOverlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.95);
            backdrop-filter: blur(12px);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
        }

        .form-container {
            width: 100%;
            max-width: 500px;
            padding: 1rem;
        }

        .form-control, .form-select {
            background: #111;
            border: 1px solid var(--antique-brass);
            color: var(--text-bright);
            border-radius: 0;
        }

        .form-control:focus, .form-select:focus {
            background: #1a1a1a;
            border-color: var(--gold);
            box-shadow: 0 0 10px var(--gold-glow);
            color: var(--text-bright);
        }

        /* Badges */
        .badge-role {
            font-family: 'Cinzel', serif;
            font-size: 0.7rem;
            padding: 0.4em 0.8em;
            border: 1px solid var(--gold-muted);
            color: var(--gold);
            background: rgba(212, 175, 55, 0.1);
            text-transform: uppercase;
        }
        .logout-btn {
        background: rgba(153, 27, 27, 0.1);
        border: 1px solid rgba(153, 27, 27, 0.4);
        padding: 0.5rem 0.75rem;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        transition: all 0.3s ease;
      }

      .logout-btn:hover {
        background: rgba(153, 27, 27, 0.2);
        border-color: var(--red-bright);
      }

      .logout-btn span {
        font-size: 0.5rem;
        color: var(--red);
        font-weight: bold;
        text-transform: uppercase;
        margin-top: 2px;
      }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--obsidian); }
        ::-webkit-scrollbar-thumb { background: var(--antique-brass); }
        
        @media (max-width: 576px) {
            .royal-navbar { padding: 0 1rem; }
            .admin-email { display: none; }
            .admin-name { font-size: 0.8rem; }
            .royal-navbar h2 { font-size: 1rem; }
        }
        .actions{
            display: flex;
            justify-content: flex-end;
        }
    </style>
</head>
<body>

    <!-- Royal Navigation Bar -->
    <nav class="royal-navbar">
        <h2 class="h5 m-0 gold-text d-none d-sm-block">Imperial Command</h2>
        <div class="admin-profile">
            <div class="admin-info text-end">
                <span class="admin-name"><%=username %></span>
                <span class="admin-email"><%=email %></span>
                <span class="admin-role-tag">Admin</span>
            </div>
            <div class="admin-avatar">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="var(--gold)">
                    <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 6c1.1 0 2 .9 2 2s-.9 2-2 2-2-.9-2-2 .9-2 2-2zm0 12c-2.67 0-5.33-1.33-5.33-4v-1h10.66v1c0 2.67-2.66 4-5.33 4z"/>
                </svg>
            </div>
            <a href="/admin/logout" style="text-decoration: none;">
                <button class="logout-btn" id="logout-trigger" title="Abandon Post">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#991b1b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    <span style="color: rgb(218, 124, 124);" >Logout</span>
                </button>
            </a>
        </div>
    </nav>

    <div class="dashboard-container">
        <header class="header-section">
            <h1 class="gold-text mb-2">The Royal Archives</h1>
            <p class="small fst-italic text-secondary">Command Center for the Imperial Administration</p>
        </header>

        <form action="/admin/filter" method="post">
            <div class="search-container">
                <div class="search-wrapper">
                    <div class="search-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    </div>
                    <input name="search" type="text" id="searchInput" class="search-input" value="<%=searchKey%>" placeholder="Seek an identity in the archives...">
                </div>
                <button type="submit" id="searchButton" class="btn-seek">Seek</button>
            </div>
        </form>

        <div class="all">
            <a href="/admin/admin_dashboard"><button id="searchButton" class="btn-seek">All users</button></a>
        </div>

        <main class="regal-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="h5 m-0 gold-text">User Directory</h2>
                <a href="/admin/add_user"><button class="btn btn-royal">Add User</button></a>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Identity</th>
                            <th>E-mail Address</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="userTableBody">
                        <% userList.forEach(user => { %>
                        <tr>
                            <td><div class="identity-text"><%=user.username %></div></td>
                            <td><span class="courier-text"><%=user.email %></span></td>
                            <td><span class="badge badge-role">user</span></td>
                            <td class="text-end actions">
                                <form action="/admin/edit_user_details/<%= user._id %>" method="post"><button class="btn btn-royal btn-sm me-2">Alter</button></a></form>
                                <form action="/admin/delete_user/<%= user._id %>" method="post"><button type="submit" class="btn btn-royal btn-banish btn-sm" onclick="return confirm('Do you want to delete this user ? ')">Banish</button></form>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
                <% if (userList.length < 1) { %>
                     <div class="d-flex justify-content-center align-items-center mt-4" style="width: 100%">
                        <h2 class="h5 m-5 gold-text">No Users</h2>
                    </div>
                <% } %>
            </div>
        </main>
    </div>

    <!-- Script for handling backward and forward cache  -->
     <script>
        window.addEventListener('pageshow',(event) => {
            if(window.performance && window.performance.navigation.type === 2){
                window.location.reload()
            }
        })
     </script>
</body>
</html>